# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/
share/python-wheels/
*.so

# Virtual environments
.venv/
.venv-turboquant/
.venv-kvpress/
.venv-kvpress312/
venv/
# V9: upstream turboquant_plus clone (dev-only; set PYTHONPATH)
vendor/turboquant_plus/
ENV/
env/

# Tests
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Model weights / HF cache (never commit these)
*.bin
*.safetensors
*.gguf

# Benchmark outputs (keep .gitkeep, ignore generated files)
outputs/
results/
reports/*.json
reports/*.csv
# Generated markdown reports (keep .gitkeep, ignore generated .md files)
docs/generated/*.md
*.log

# Prompt JSONL files committed under benchmarks/prompts/ are tracked explicitly.
# All other *.jsonl are ignored (e.g. benchmark output reports).
*.jsonl
!benchmarks/prompts/*.jsonl
